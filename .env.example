# KeepVan — variáveis de ambiente (copie para .env e preencha).
# Em modo MOCK (VITE_DATA_MODE=mock) o app roda sem nenhuma dessas chaves.

# Modo de dados: "mock" (dev, sem backend) | "firebase" (produção)
VITE_DATA_MODE=mock

# Firebase (produção) — projeto no plano Blaze
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps (GPS/rotas/geofence)
VITE_GOOGLE_MAPS_API_KEY=

# Asaas (Pix) e WhatsApp/Anthropic ficam em Cloud Functions (server-side),
# nunca no client. Ver functions/.env quando o backend for criado.
